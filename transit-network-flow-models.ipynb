   "source": [
    "multi_solution = pd.read_csv(\n",
    "    \"outputs/sol_mincost_multi_destination.txt\",\n",
    "    sep=r\"\\s+\",\n",
    "    engine=\"python\"\n",
    ")\n",
    "\n",
    "dual_summary = (\n",
    "    multi_solution.query(\"Dual < 0\")\n",
    "    .drop_duplicates(subset=[\"i\", \"j\", \"Dual\"])\n",
    "    [[\"i\", \"j\", \"capacity\", \"Dual\"]]\n",
